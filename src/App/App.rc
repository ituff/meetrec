#include <winver.h>
#include "Version.h"

// Application icon (resource id 1): blue tile + white camcorder mark.
1 ICON "MeetRec.ico"

1 VERSIONINFO
FILEVERSION VSR_APP_VERSION_FILE
PRODUCTVERSION VSR_APP_VERSION_FILE
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "MeetRec"
      VALUE "FileVersion", VSR_APP_VERSION_STR
      VALUE "ProductName", "MeetRec"
      VALUE "ProductVersion", VSR_APP_VERSION_STR
      VALUE "OriginalFilename", "MeetRec.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
