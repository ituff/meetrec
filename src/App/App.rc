#include <winver.h>

// Application icon (resource id 1): blue tile + white camcorder mark.
1 ICON "MeetRec.ico"

1 VERSIONINFO
FILEVERSION 1,1,0,0
PRODUCTVERSION 1,1,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "MeetRec"
      VALUE "FileVersion", "1.1.0.0"
      VALUE "ProductName", "MeetRec"
      VALUE "ProductVersion", "1.1.0.0"
      VALUE "OriginalFilename", "MeetRec.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
