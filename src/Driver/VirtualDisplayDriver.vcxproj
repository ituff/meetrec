<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="17.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <!-- Defined early: the WppEnabled item metadata below expands $(WDKRoot). -->
  <PropertyGroup>
    <WDKRoot Condition="'$(WDKRoot)' == ''">C:\Program Files (x86)\Windows Kits\10</WDKRoot>
    <WDKVer Condition="'$(WDKVer)' == ''">10.0.26100.0</WDKVer>
    <WdfUmdfVer Condition="'$(WdfUmdfVer)' == ''">2.25</WdfUmdfVer>
    <IddcxVer Condition="'$(IddcxVer)' == ''">1.10</IddcxVer>
  </PropertyGroup>
  <ItemGroup>
    <ClCompile Include="Driver.cpp">
      <!-- WPP software tracing (NFR-034); generated by the RunWpp target below. -->
      <WppEnabled>true</WppEnabled>
      <WppScanConfigurationData>$(ProjectDir)Trace.h</WppScanConfigurationData>
      <WppKernelMode>false</WppKernelMode>
      <WppAdditionalIncludeDirectories>$(ProjectDir)</WppAdditionalIncludeDirectories>
      <WppConfigurationDirectories>$(WDKRoot)\bin\$(WDKVer)\WppConfig\Rev1</WppConfigurationDirectories>
    </ClCompile>
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="Driver.h" />
    <ClInclude Include="Edid.h" />
    <ClInclude Include="Trace.h" />
  </ItemGroup>
  <ItemGroup>
    <Inf Include="VirtualDisplayDriver.inf" />
  </ItemGroup>
  <ItemGroup>
    <ResourceCompile Include="VirtualDisplayDriver.rc" />
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{D18CADB7-9CCF-4FE4-A6A7-F8EADCB4C9D3}</ProjectGuid>
    <RootNamespace>VirtualDisplayDriver</RootNamespace>
    <WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <OutDir>$(SolutionDir)artifacts\$(Configuration)\driver\</OutDir>
    <IntDir>$(SolutionDir)artifacts\obj\$(Configuration)\$(ProjectName)\</IntDir>
    <TargetName>VirtualDisplayDriver</TargetName>
    <TargetExt>.dll</TargetExt>
    <GenerateManifest>false</GenerateManifest>
  </PropertyGroup>
  <PropertyGroup>
    <WDKRoot Condition="'$(WDKRoot)' == ''">C:\Program Files (x86)\Windows Kits\10</WDKRoot>
    <WDKVer Condition="'$(WDKVer)' == ''">10.0.26100.0</WDKVer>
    <WdfUmdfVer Condition="'$(WdfUmdfVer)' == ''">2.25</WdfUmdfVer>
    <IddcxVer Condition="'$(IddcxVer)' == ''">1.10</IddcxVer>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(WDKRoot)\Include\wdf\umdf\$(WdfUmdfVer);$(WDKRoot)\Include\$(WDKVer)\um;$(WDKRoot)\Include\$(WDKVer)\shared;$(WDKRoot)\Include\$(WDKVer)\um\iddcx\$(IddcxVer);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>_WIN64;_AMD64_;AMD64;_ATL_NO_WIN_SUPPORT;UMDF_DRIVER;IDDCX_VERSION_MAJOR=1;IDDCX_VERSION_MINOR=10;IDDCX_MINIMUM_VERSION_REQUIRED=10;_WDF_USER_MODE_DRIVER_;WIN32_LEAN_AND_MEAN=1;WPP_MACRO_USE_KM_VERSION_FOR_UM=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ExceptionHandling>Sync</ExceptionHandling>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>false</TreatWarningAsError>
      <DisableSpecificWarnings>4005;4100;4189;4101;4324</DisableSpecificWarnings>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <AdditionalDependencies>OneCoreUAP.lib;advapi32.lib;ntdll.lib;avrt.lib;iddcxstub.lib;WdfDriverStubUm.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalLibraryDirectories>$(WDKRoot)\Lib\$(WDKVer)\um\x64\iddcx\$(IddcxVer);$(WDKRoot)\Lib\wdf\umdf\x64\$(WdfUmdfVer);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <SubSystem>Windows</SubSystem>
      <MinimumRequiredVersion>10.00</MinimumRequiredVersion>
    </Link>
  </ItemDefinitionGroup>

  <!--
    WPP software tracing (NFR-034). The WDK's Wpp MSBuild task drives tracewpp.exe
    over Driver.cpp to generate Driver.tmh (included by Driver.cpp); Trace.h is the
    scan configuration holding the control GUIDs and trace macros. This mirrors the
    RunWpp target in the WDK's WindowsDriver.Common.targets and stays local because
    the project builds with the stock v143 toolset rather than the WDK toolset.
    Requires tracewpp.exe under $(TraceWppToolPath).
  -->
  <PropertyGroup>
    <WDKContentRoot Condition="'$(WDKContentRoot)' == ''">$(WDKRoot)\</WDKContentRoot>
    <WDKBuildFolder Condition="'$(WDKBuildFolder)' == ''">$(WDKVer)</WDKBuildFolder>
    <TraceWppToolPath Condition="'$(TraceWppToolPath)' == ''">$(WDKRoot)\bin\$(WDKVer)\x64\</TraceWppToolPath>
    <TraceWppToolArchitecture Condition="'$(TraceWppToolArchitecture)' == ''">Native64Bit</TraceWppToolArchitecture>
  </PropertyGroup>

  <UsingTask TaskName="Wpp" AssemblyFile="$(WDKContentRoot)build\$(WDKBuildFolder)\bin\Microsoft.DriverKit.Build.Tasks.$(VisualStudioVersion).dll" />

  <Target Name="RunWpp" BeforeTargets="BeforeClCompile">
    <ItemGroup>
      <TraceWpp Include="@(ClCompile)" Condition="'%(ClCompile.WppEnabled)' == 'true' and '%(ClCompile.ExcludedFromBuild)' != 'true'" />
    </ItemGroup>
    <Wpp Condition="'@(TraceWpp)' != ''"
         Sources="@(TraceWpp)"
         ScanConfigurationData="%(TraceWpp.WppScanConfigurationData)"
         KernelMode="%(TraceWpp.WppKernelMode)"
         TraceFunction="%(TraceWpp.WppTraceFunction)"
         AdditionalIncludeDirectories="%(TraceWpp.WppAdditionalIncludeDirectories)"
         ConfigurationDirectories="%(TraceWpp.WppConfigurationDirectories)"
         PreprocessorDefinitions="%(TraceWpp.WppPreprocessorDefinitions)"
         ToolExe="$(TraceWppToolExe)"
         ToolPath="$(TraceWppToolPath)"
         ToolArchitecture="$(TraceWppToolArchitecture)"
         TrackFileAccess="$(TrackFileAccess)" />
  </Target>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
